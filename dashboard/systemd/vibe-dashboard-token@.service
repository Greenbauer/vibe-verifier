# Mints dashboard NAME's read token into its gh hosts.yml, as root. Linux, systemd.
# Root keeps its capabilities: it reads the dashboard's own 0600 configuration and hands the token to
# that account. /etc/vibe-dashboard/NAME/host.env supplies APP, INSTALLATION and LOGIN.
[Unit]
Description=Refresh the read token of Vibe Verifier dashboard %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/vibe-dashboard/%i/host.env
ExecStart=/usr/bin/env -i HOME=/root PYTHONNOUSERSITE=1 PATH=/usr/bin:/bin /usr/bin/python3 /opt/vibe-verifier/bin/vibe-dashboard-host token --config /etc/vibe-dashboard/%i/dashboard.json --user vibe-dashboard-%i --app ${APP} --installation ${INSTALLATION} --key /etc/vibe-dashboard/%i/app.pem --login ${LOGIN} --output /var/lib/vibe-dashboard/%i/gh/hosts.yml
TimeoutStartSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/vibe-dashboard/%i/gh
UMask=0077

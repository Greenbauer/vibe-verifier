  "/errors": "<title>errors</title><h1>Errors</h1><input type='password' aria-label='Loose password'><script>\nconst quiet = request => request.catch(() => {});\nconsole.error('site error');\nquiet(fetch('/api/missing')); quiet(fetch('/api/private')); quiet(fetch('/api/boom'));\nquiet(fetch('{OTHER}/api/data')); quiet(fetch('{OTHER}/api/boom')); quiet(fetch('{CLOSED}/api/down'));\nnew WebSocket('{SOCKET}/socket');\nconst img = new Image(); img.src = '/img/never.svg'; document.body.append(img); setTimeout(() => { img.removeAttribute('src'); img.remove(); }, 200);\nPromise.reject('rejected string');\nsetTimeout(() => { throw new Error('boom'); }, 50);\n</script>",
  "/shop": "<title>shop</title><h1>Shop</h1><a id='pay' target='_blank' href='{OTHER}/checkout?session=1'>Pay</a>",
  "/dashboard": "<title>dashboard</title><h1>Dashboard</h1><img src='/img/logo.svg' alt='logo'><script>fetch('/api/items')</script>",
  "/developers": "<title>developers</title><h1>Developers</h1><script>\nconst quiet = request => request.catch(() => {});\nconst img = new Image(); img.src = '/img/logo.svg'; document.body.append(img); setTimeout(() => { img.removeAttribute('src'); img.remove(); }, 200);\nfor (const path of ['/api/items', '/api/slow']) { const stop = new AbortController(); quiet(fetch(path, { signal: stop.signal })); setTimeout(() => stop.abort(), 100); }\n</script>",
  "/form": "<title>order</title><main><h1>Order</h1><form><label>Quantity <input name='quantity'></label><button>Save</button></form></main><script>\ndocument.querySelector('form').addEventListener('submit', async event => { event.preventDefault();\n  const answer = await fetch('/api/quantity', { method: 'POST', body: JSON.stringify({ quantity: event.target.quantity.value }) });\n  if (!answer.ok) event.target.insertAdjacentHTML('beforeend', '<p>Quantity must be a positive number</p>'); });\n</script>",
  "/orders": "<title>orders</title><h1>Orders</h1><p id='state'>loading</p><script>fetch('/api/orders').then(answer => { document.getElementById('state').textContent = answer.ok ? '2 orders' : 'Something went wrong'; })</script>",
  "/login": "<title>login</title><h1>Welcome back</h1><form><label>Email address <input type='email'></label><label>Password <input type='password'></label><button>Sign in</button></form><p role='status'></p><script>\nlet signedIn = 0;\ndocument.querySelector('form').addEventListener('submit', async event => { event.preventDefault();\n  const password = document.querySelector('input[type=password]').value;\n  const answer = await fetch('/auth/token', { method: 'POST', body: JSON.stringify({ password }) });\n  document.querySelector('[role=status]').textContent = answer.ok ? 'Signed in (' + ++signedIn + ')' : 'Invalid login'; });\n</script>"
 },

# Gates this repository subscribes to. One per line: <gate> [args]
branch-name-length --max 60
gitleaks
actionlint
zizmor
cognitive-complexity
max-file-lines
no-duplicate-package-json-keys
build-tools-in-devdependencies
new-source-has-test
# docs/features/: every gate (its GATE name) and every subcommand of bin/vibe-verifier is owned by a feature file.
feature-map --surface gate 'gates/*.py' '^GATE = "([a-z0-9-]+)"$' --surface command bin/vibe-verifier 'commands\.add_parser\("([a-z-]+)"'

# One Vibe Verifier dashboard, instance NAME, served on loopback as its own account. Linux, systemd.
# Setup, including /etc/vibe-dashboard/NAME/host.env (PORT): docs/dashboard-host.md.
[Unit]
Description=Vibe Verifier dashboard %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vibe-dashboard-%i
Group=vibe-dashboard-%i
EnvironmentFile=/etc/vibe-dashboard/%i/host.env
WorkingDirectory=/
ExecStart=/usr/bin/env -i HOME=/var/lib/vibe-dashboard/%i GH_CONFIG_DIR=/var/lib/vibe-dashboard/%i/gh GH_PROMPT_DISABLED=1 PYTHONNOUSERSITE=1 PATH=/usr/bin:/bin /usr/bin/python3 /opt/vibe-verifier/bin/vibe-dashboard --config /etc/vibe-dashboard/%i/dashboard.json --port ${PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=100%
# A refresh runs four gh calls at once and each is a Go program with about fifteen threads, so 64
# left the web server no thread for a page request. 256 still stops a runaway.
TasksMax=256
UMask=0077

[Install]
WantedBy=multi-user.target

#!/usr/bin/env python3
"""Keep dashboards running on the newest merged code.

Every interval this fetches the branch from origin and fast-forwards this checkout to it. Merged
changes to the server's Python restart the dashboards; changes under dashboard/static/ go live
without a restart, because the server reads those files on every request. A change to this script
re-runs it. A dashboard that exits is started again. Run it from a checkout nobody edits, under a
service manager (launchd, systemd) that starts it again if it exits."""

import argparse
import os
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SELF = "bin/vibe-dashboard-follow"


def log(message: str) -> None:
    print("%s vibe-dashboard-follow: %s" % (time.strftime("%Y-%m-%dT%H:%M:%S"), message), flush=True)


def git(root: str, *args: str) -> str:
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, check=True).stdout.strip()


def update(root: str, branch: str) -> list[str]:
    """Fast-forward to origin's branch and return the changed paths ([] when already current).
    Raises CalledProcessError when origin is unreachable or the checkout cannot fast-forward."""
    git(root, "fetch", "--quiet", "origin", branch)
    old, new = git(root, "rev-parse", "HEAD"), git(root, "rev-parse", "FETCH_HEAD")
    if old == new:
        return []
    git(root, "merge", "--ff-only", "--quiet", "FETCH_HEAD")
    log("updated %s to %s" % (old[:8], new[:8]))
    return git(root, "diff", "--name-only", old, new).splitlines()


def needs_restart(paths: list[str]) -> bool:
    """The running server has loaded dashboard/*.py and bin/vibe-dashboard; static files it does not hold."""
    return any(path == "bin/vibe-dashboard" or
               (path.startswith("dashboard/") and not path.startswith("dashboard/static/")) for path in paths)


class Dashboards:
    def __init__(self, serves: list[tuple[str, str]]):
        self.serves = serves
        self.processes = [None] * len(serves)

    def start(self) -> None:
        for index, (config, port) in enumerate(self.serves):
            process = self.processes[index]
            if process is None or process.poll() is not None:
                if process is not None:
                    log("dashboard on port %s exited with %s; starting it again" % (port, process.returncode))
                self.processes[index] = subprocess.Popen(
                    [sys.executable, os.path.join(ROOT, "bin/vibe-dashboard"), "--config", config, "--port", port])

    def stop(self) -> None:
        for process in self.processes:
            if process is not None and process.poll() is None:
                process.terminate()
        for process in self.processes:
            if process is not None:
                try:
                    process.wait(10)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
        self.processes = [None] * len(self.serves)


def main() -> int:
    parser = argparse.ArgumentParser(prog="vibe-dashboard-follow", description=__doc__)
    parser.add_argument("--serve", nargs=2, action="append", required=True, metavar=("CONFIG", "PORT"),
                        help="a dashboard to run; repeat for several owners")
    parser.add_argument("--branch", default="main", help="origin branch to follow (default: main)")
    parser.add_argument("--interval", type=int, default=60, help="seconds between checks (default: 60)")
    args = parser.parse_args()
    dashboards = Dashboards([tuple(serve) for serve in args.serve])
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        dashboards.start()
        while True:
            time.sleep(args.interval)
            dashboards.start()
            try:
                paths = update(ROOT, args.branch)
            except subprocess.CalledProcessError as error:
                log("could not update, still serving the current code: %s" % (error.stderr or "").strip())
                continue
            if SELF in paths:
                log("this script changed; running the new copy")
                dashboards.stop()
                os.execv(sys.executable, [sys.executable, *sys.argv])
            if needs_restart(paths):
                log("server code changed; restarting the dashboards")
                dashboards.stop()
                dashboards.start()
    finally:
        dashboards.stop()


if __name__ == "__main__":
    raise SystemExit(main())

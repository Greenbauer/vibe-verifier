# Gates this repository subscribes to. One per line: <gate> [args]
branch-name-length --max 60
gitleaks
actionlint
zizmor
bandit
osv-scanner
cognitive-complexity
max-file-lines
no-duplicate-package-json-keys
build-tools-in-devdependencies
new-source-has-test
# docs/features/: every gate (its GATE name) and every subcommand of bin/vibe-verifier is owned by a feature file.
feature-map --surface gate 'gates/*.py' '^GATE = "([a-z0-9-]+)"$' --surface command bin/vibe-verifier 'commands\.add_parser\("([a-z-]+)"'
# repo-rules: the catalog's own typescript pack on its JavaScript (dashboard/static, actions/*, tools/*), the
# same rules every subscribed repository runs. No finding today (--all, 2026-10-19), and it ratchets per rule and file.
repo-rules --pack typescript
# prose: an em dash, or an en dash used as an aside, on an added Markdown line blocks; a curly quote and
# the pull request description are advisory. The same rule every subscribed repository runs.
prose

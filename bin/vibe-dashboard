#!/usr/bin/env python3
"""Start the private, read-only Vibe Verifier dashboard on loopback."""

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from dashboard.config import ConfigError, load_config  # noqa: E402
from dashboard.server import make_server  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="vibe-dashboard", description=__doc__)
    parser.add_argument("--config", required=True, help="owned local JSON configuration file")
    parser.add_argument("--port", default=8765, type=int, help="loopback port (default: 8765)")
    parser.add_argument("--state-dir", default=os.environ.get("VIBE_DASHBOARD_STATE_DIR"),
                        help="a directory of this account's own, for the last reading and the GitHub caches, so a "
                             "restart shows the previous reading instead of nothing (default: "
                             "$VIBE_DASHBOARD_STATE_DIR; without one, nothing is kept)")
    args = parser.parse_args()
    if not 0 <= args.port <= 65535:
        parser.error("--port must be between 0 and 65535")
    try:
        config = load_config(args.config)
        server = make_server(config, args.port, state_dir=args.state_dir)
    except ConfigError as error:
        print("vibe-dashboard: %s" % error, file=sys.stderr)
        return 2
    except OSError:
        print("vibe-dashboard: could not bind to 127.0.0.1", file=sys.stderr)
        return 2
    print("Vibe Verifier dashboard for %s: http://127.0.0.1:%s" % (config.owner, server.server_port), flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
